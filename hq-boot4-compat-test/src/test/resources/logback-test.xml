<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
  <property name="CONSOLE_LOG_FMT" value="${CONSOLE_LOG_FMT:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd.HH:mm:ss.SSS}} [%-22t] ${LOG_LEVEL_PATTERN:-%-5p} %-30logger{0} - %m%n}"/>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_FMT}</pattern>
    </encoder>
  </appender>
  <!-- RestClientLoggingInterceptor 的 body 日志分支只在 debug 下走，探针要覆盖它 -->
  <logger name="boot4-probe.RestClient" level="DEBUG"/>
  <root level="${test.logger.level}">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>